#!/usr/bin/env zsh

#####################################
#
#   macOS 26 (Tahoe) Defaults
#   Author: Per Töyrä
#
#####################################

set -euo pipefail

echo "🔧 Configuring macOS defaults..."

#####################################
# RESOLVE ACTIVE CONSOLE USER
#####################################

CURRENT_USER=$(stat -f %Su /dev/console)
USER_ID=$(id -u "$CURRENT_USER")

as_user() {
  sudo -u "$CURRENT_USER" defaults "$@"
}

#####################################
# MENU BAR / CONTROL CENTER
#####################################

echo "→ Configuring menu bar..."

as_user write com.apple.controlcenter "NSStatusItem Visible Bluetooth" -bool true
as_user write com.apple.controlcenter "NSStatusItem Visible Sound" -bool true

#####################################
# FINDER
#####################################

echo "→ Configuring Finder..."

as_user write com.apple.finder NewWindowTarget -string "PfHm"
as_user write com.apple.finder FXEnableExtensionChangeWarning -bool false
as_user write NSGlobalDomain AppleShowAllExtensions -bool true
as_user write com.apple.finder ShowPathbar -bool true
as_user write com.apple.finder ShowStatusBar -bool true
as_user write com.apple.finder FXPreferredViewStyle -string "Nlsv"

as_user write com.apple.desktopservices DSDontWriteNetworkStores -bool true
as_user write com.apple.desktopservices DSDontWriteUSBStores -bool true

#####################################
# DOCK
#####################################

echo "→ Configuring Dock..."

as_user write com.apple.dock show-recents -bool false
as_user write com.apple.dock mru-spaces -bool false

# Hot corners
as_user write com.apple.dock wvous-tl-corner -int 2
as_user write com.apple.dock wvous-tl-modifier -int 0
as_user write com.apple.dock wvous-tr-corner -int 4
as_user write com.apple.dock wvous-tr-modifier -int 0

#####################################
# KEYBOARD
#####################################

echo "→ Configuring keyboard..."

as_user write NSGlobalDomain ApplePressAndHoldEnabled -bool false
as_user write NSGlobalDomain KeyRepeat -int 1
as_user write NSGlobalDomain InitialKeyRepeat -int 10
as_user write NSGlobalDomain AppleKeyboardUIMode -int 3
as_user write NSGlobalDomain com.apple.keyboard.fnState -bool true

as_user write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
as_user write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
as_user write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
as_user write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false

#####################################
# SYSTEM SETTINGS
#####################################

echo "→ Configuring system settings..."

as_user write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
as_user write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true
as_user write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true

as_user write NSGlobalDomain com.apple.sound.beep.feedback -integer 1
as_user write com.apple.TimeMachine DoNotOfferNewDisksForBackup -bool true
as_user write com.apple.ImageCapture disableHotPlug -bool true
as_user write com.apple.loginwindow TALLogoutSavesState -bool false

# Faster window resize animation
as_user write NSGlobalDomain NSWindowResizeTime -float 0.001

#####################################
# FIREWALL
#####################################

echo "→ Configuring firewall..."

sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setallowsigned off
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setallowsignedapp off

#####################################
# AUTOMATIC UPDATES
#####################################

echo "→ Configuring software updates..."

# Enable automatic update checking
sudo softwareupdate --schedule on

# Configure automatic update behavior via system plist
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate ConfigDataInstall -bool true

# Disable automatic full macOS upgrades
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates -bool false

# App Store auto updates
sudo defaults write /Library/Preferences/com.apple.commerce AutoUpdate -bool true

#####################################
# TERMINAL
#####################################

echo "→ Configuring Terminal..."

as_user write com.apple.terminal SecureKeyboardEntry -bool true

#####################################
# TOUCH ID FOR SUDO
#####################################

echo "→ Enabling Touch ID for sudo..."

if ! grep -q "pam_tid.so" /private/etc/pam.d/sudo_local 2>/dev/null; then
  echo "auth       sufficient     pam_tid.so" | sudo tee -a /private/etc/pam.d/sudo_local > /dev/null
  echo "Touch ID enabled for sudo."
else
  echo "Touch ID already configured."
fi

#####################################
# RESTART USER SERVICES
#####################################

echo "→ Restarting affected services..."

killall cfprefsd 2>/dev/null || true
killall SystemUIServer 2>/dev/null || true
killall Finder 2>/dev/null || true
killall Dock 2>/dev/null || true
killall TextInputMenuAgent 2>/dev/null || true

echo ""
echo "✅ macOS configuration complete!"
echo "⚠️ Some changes may require logout/restart."
echo ""
